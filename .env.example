SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY
ADMIN_PASSWORD=SET_A_LONG_PRIVATE_PASSWORD
PORT=3000

# Neon / PostgreSQL: set this ONLY after restoring and verifying the database.
# Use Neon pooled URL for runtime; direct URL for pg_restore and verification.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=verify-full
# Single server replica only. Set 0 if external writers or multiple replicas are used.
DB_READ_CACHE_SECONDS=15
# Neon mode: required only for finance receipt uploads/downloads. Use a persistent volume.
# RECEIPT_STORAGE_DIR=/data/finance-receipts
